/* QtEventWatcher demo style - generated from StyleTokens */
QWidget { background:#f2f3f5; color:#1f2328; font-size:13px; font-family:"Segoe UI", "Microsoft YaHei UI"; }QMainWindow, #CentralWidget { background:#f2f3f5; }#HeaderBar { background:#ffffff; border-bottom:1px solid #d8dce2; }QLabel#HeaderTitle { font-size:17px; font-weight:600; }QLabel#SubLabel { color:#6e7781; }#SideNav { background:#f2f3f5; border-right:1px solid #d8dce2; }QPushButton[nav="true"] { background:transparent; border:none; border-radius:8px; padding:8px 16px; color:#6e7781; text-align:left; }QPushButton[nav="true"]:hover { background:#e9ecef; color:#1f2328; }QPushButton[nav="true"]:checked { background:#e9ecef; color:#4c8dff; font-weight:600; }#KpiCard { background:#ffffff; border:1px solid #d8dce2; border-left:3px solid #4c8dff; border-radius:10px; }QLabel#KpiValue { font-size:22px; font-weight:600; color:#1f2328; }QLabel#KpiTitle { color:#6e7781; font-size:12px; }#CardPanel { background:#ffffff; border:1px solid #d8dce2; border-radius:10px; }QGroupBox { background:#ffffff; border:1px solid #d8dce2; border-radius:10px; margin-top:14px; padding:16px; font-weight:600; }QGroupBox::title { subcontrol-origin: margin; left:12px; padding:0 4px; color:#6e7781; }QPushButton { background:#ffffff; border:1px solid #d8dce2; border-radius:8px; padding:8px 16px; color:#1f2328; }QPushButton:hover { background:#e9ecef; border-color:#d8dce2; }QPushButton:pressed { background:#d8dce2; }QPushButton:disabled { color:#6e7781; border-color:#d8dce2; }QPushButton[accent="true"] { background:#4c8dff; border:none; color:#ffffff; font-weight:600; }QPushButton[accent="true"]:hover { background:#4c8dff; }QPushButton[accent="true"]:pressed { background:#4c8dff; }QPushButton[danger="true"] { color:#cf222e; border-color:#cf222e; }QListWidget { background:#ffffff; border:1px solid #d8dce2; border-radius:10px; padding:8px; font-family:"Consolas", "Courier New"; font-size:12px; }QListWidget::item { color:#1f2328; padding:4px 6px; border-radius:4px; }QListWidget::item:hover { background:#e9ecef; }QListWidget::item:selected { background:#e9ecef; color:#1f2328; }QTableWidget { background:#ffffff; border:1px solid #d8dce2; border-radius:10px; gridline-color:#d8dce2; selection-background-color:#e9ecef; selection-color:#1f2328; }QTableWidget::item { padding:2px 6px; border:none; }QHeaderView::section { background:#ffffff; color:#6e7781; border:none; border-bottom:1px solid #d8dce2; padding:4px 6px; font-weight:600; }QTableCornerButton::section { background:#ffffff; border:none; }QPlainTextEdit { background:#ffffff; border:1px solid #d8dce2; border-radius:10px; padding:8px; font-family:"Consolas", "Courier New"; font-size:12px; color:#1f2328; }QLabel#StatusLabel { color:#6e7781; padding:8px; border-radius:8px; background:#ffffff; border:1px solid #d8dce2; }QLabel#EmptyState { color:#6e7781; padding:8px; }QLabel#PageHint { color:#6e7781; }QStatusBar { background:#ffffff; color:#6e7781; border-top:1px solid #d8dce2; }QLabel#DemoBadge { background:#9a6700; color:#f2f3f5; border-radius:6px; padding:2px 10px; font-weight:700; font-size:12px; }QScrollBar:vertical { background:transparent; width:8px; margin:0; }QScrollBar::handle:vertical { background:#d8dce2; border-radius:4px; min-height:24px; }QScrollBar::handle:vertical:hover { background:#6e7781; }QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:transparent; }QScrollBar:horizontal { background:transparent; height:8px; margin:0; }QScrollBar::handle:horizontal { background:#d8dce2; border-radius:4px; min-width:24px; }QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width:0; }QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background:transparent; }